# Copy to .env (git-ignored) and fill in. Never commit real keys.

# DeepSeek API key: used by the agent backend when ATLAS_PROVIDER is deepseek (or is unset and no Anthropic key is present).
DEEPSEEK_API_KEY=
# Anthropic API key: used by the agent backend for the anthropic provider (preferred automatically when set and ATLAS_PROVIDER is unset).
ANTHROPIC_API_KEY=
# Optional: force the provider, "anthropic" or "deepseek". Empty = auto-pick from whichever key is present.
ATLAS_PROVIDER=
# Optional: model id for the chosen provider. Empty = provider default (see agent/README.md).
ATLAS_MODEL=
# Optional, viewer only: Cesium ion token for the higher-resolution Mars tileset. Without it the globe uses the NASA/USGS Viking mosaic from Mars Trek.
# The viewer reads it from the repo-root .env.local or .env (both git-ignored); see usage.md.
VITE_CESIUM_ION_TOKEN=
